load("//build/bzl:python.bzl", "o_py_binary", "o_py_library", "o_py_test")

o_py_library(
    name = "cli_lib",
    srcs = [
        "__init__.py",
        "dag_cmd.py",
        "dag_gui.py",
        "main.py",
        "shell.py",
        "show.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//mlody/common:context_lib",  # keep
        "//mlody/core:core_lib",
        "//mlody/core:derived",  # keep — show.py imports materialise_derived, DerivedValueShapeError
        "//mlody/db:db_lib",
        "//mlody/resolver:resolver_lib",
        "@pip//click",
        "@pip//matplotlib",  # keep — lazy import in dag_gui.show_dag_gui
        "@pip//networkx",
        "@pip//ptpython",
        "@pip//pyarrow",  # keep — show.py reads derived parquet output
        "@pip//rich",
    ],
)

o_py_test(
    name = "cli_test",
    srcs = ["main_test.py"],
    deps = [
        ":cli_lib",
        "@pip//click",
    ],
)

o_py_library(
    name = "show_lib",
    srcs = ["show.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":cli_lib",
        "//mlody/core:derived",  # keep — materialise_derived, DerivedValueShapeError
        "//mlody/core:workspace_lib",
        "//mlody/db:db_lib",  # keep — show.py imports open_db, write_evaluation, compute_local_diff_sha
        "@pip//click",
        "@pip//pyarrow",  # keep — derived value parquet reading
        "@pip//rich",
    ],
)

o_py_library(
    name = "shell_lib",
    srcs = ["shell.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":cli_lib",
        ":show_lib",
        "//mlody/core:workspace_lib",
        "@pip//click",
        "@pip//ptpython",
    ],
)

o_py_test(
    name = "shell_test",
    srcs = ["shell_test.py"],
    deps = [
        ":cli_lib",
        "//common/python/starlarkish",
        "//mlody/core:derived",
        "@pip//click",
        "@pip//pytest",
    ],
)

o_py_binary(
    name = "mlody",
    srcs = ["__main__.py"],
    main = "__main__.py",
    package_collisions = "warning",
    visibility = ["//visibility:public"],
    deps = [":cli_lib"],
)

o_py_test(
    name = "show_test",
    srcs = ["show_test.py"],
    deps = [
        ":cli_lib",
        ":show_lib",
        "//common/python/starlarkish/core:core_lib",
        "//common/python/starlarkish",
        "//mlody/core:derived",  # keep — DerivedValueShapeError
        "//mlody/core/sql:sql_query_lib",  # keep — MlodyQueryError
        "//mlody/resolver:resolver_lib",
        "@pip//click",
        "@pip//networkx",  # keep — TestShowCommandDagPlan
        "@pip//pyarrow",  # keep — derived value test tables
        "@pip//pytest",
    ],
)

o_py_test(
    name = "main_test",
    srcs = ["main_test.py"],
    deps = [
        ":cli_lib",
        "@pip//click",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "dag_cmd_test",
    srcs = ["dag_cmd_test.py"],
    deps = [
        ":cli_lib",
        "//common/python/starlarkish",
        "@pip//click",
    ],
)
