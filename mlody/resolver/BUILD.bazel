# gazelle:ignore
load("//build/bzl:python.bzl", "o_py_library", "o_py_test")

o_py_library(
    name = "resolver_lib",
    srcs = [
        "__init__.py",
        "cache.py",
        "errors.py",
        "git_client.py",
        "label_value.py",
        "resolver.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//common/python/console:console_lib",  # keep — label_value.py imports RichDomNode
        "//common/python/starlarkish/core:core_lib",
        "//mlody/core:core_lib",
        "//mlody/core/label:label_lib",
        "//mlody/core/parquet:parquet_lib",  # keep — label_value.py inline-imports ParquetDeserializer and read_file_as_rows
        "//mlody/core/tabular:tabular",
        "//mlody/db:db_lib",  # keep — resolver.py imports open_db, write_evaluation, compute_local_diff_sha
        "@pip//pyarrow",  # keep — label_value.py inline-imports pyarrow.parquet
        "@pip//rich",
    ],
)

o_py_test(
    name = "errors_test",
    srcs = ["errors_test.py"],
    deps = [
        ":resolver_lib",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "git_client_test",
    srcs = ["git_client_test.py"],
    deps = [
        ":resolver_lib",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "cache_test",
    srcs = ["cache_test.py"],
    deps = [
        ":resolver_lib",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "resolver_test",
    srcs = ["resolver_test.py"],
    deps = [
        ":resolver_lib",
        "//mlody/db:db_lib",  # keep — resolver_test queries SQLite directly after resolve_workspace
        "@pip//pytest",
    ],
)

o_py_test(
    name = "label_value_test",
    srcs = ["label_value_test.py"],
    deps = [
        ":resolver_lib",
        "//common/python/starlarkish/core:core_lib",
        "//mlody/core:core_lib",
        "@pip//pyarrow",
        "@pip//pyfakefs",  # keep — pyfakefs provides the `fs` fixture via pytest plugin
        "@pip//pytest",
    ],
)

o_py_test(
    name = "parquet_integration_test",
    srcs = ["parquet_integration_test.py"],
    deps = [
        ":resolver_lib",
        "//common/python/starlarkish/core:core_lib",
        "//mlody/core:core_lib",
        "@pip//pyarrow",  # keep — tests write real Parquet files via pyarrow
        "@pip//pytest",
    ],
)
