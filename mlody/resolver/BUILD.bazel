load("//build/bzl:python.bzl", "o_py_library", "o_py_test")

o_py_library(
    name = "resolver_lib",
    srcs = [
        "__init__.py",
        "cache.py",
        "errors.py",
        "git_client.py",
        "label_value.py",
        "resolver.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//common/python/console:console_lib",  # keep — label_value.py imports RichDomNode
        "//common/python/starlarkish/core:core_lib",
        "//mlody/common:common_lib",
        "//mlody/core:core_lib",
        "//mlody/core/label:label_lib",
        "//mlody/core/parquet",
        "//mlody/core/sql:sql_query_lib",
        "//mlody/core/tabular:derived_source_lib",
        "//mlody/core/tabular:location_specs_lib",
        "//mlody/db:db_lib",  # keep — resolver.py imports open_db, write_evaluation, compute_local_diff_sha
        "@pip//pyarrow",  # keep — label_value.py inline-imports pyarrow.parquet
        "@pip//rich",
    ],
)

o_py_test(
    name = "errors_test",
    srcs = ["errors_test.py"],
    deps = [
        ":resolver_lib",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "git_client_test",
    srcs = ["git_client_test.py"],
    deps = [
        ":resolver_lib",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "cache_test",
    srcs = ["cache_test.py"],
    deps = [
        ":resolver_lib",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "resolver_test",
    srcs = ["resolver_test.py"],
    deps = [
        ":resolver_lib",
        "//common/python/starlarkish/core:core_lib",
        "//mlody/db:db_lib",  # keep — resolver_test queries SQLite directly after resolve_workspace
        "@pip//pytest",
    ],
)

_LABEL_VALUE_TEST_DATA = [
    "//mlody/common:attrs.mlody",
    "//mlody/common:config.mlody",  # keep — read via fs.add_real_file in _make_workspace
    "//mlody/common:locations.mlody",
    "//mlody/common:mm.mlody",  # keep — read via fs.add_real_file in _make_workspace
    "//mlody/common:render.mlody",  # keep — read via fs.add_real_file in _make_workspace
    "//mlody/core:rule.mlody",  # keep — read via fs.add_real_file in _make_workspace
]

_LABEL_VALUE_TEST_DEPS = [
    ":resolver_lib",
    "//common/python/console:console_lib",
    "//common/python/starlarkish/core:core_lib",
    "//mlody/core:core_lib",
    "@pip//networkx",
    "@pip//pyarrow",
    "@pip//pyfakefs",  # keep — pyfakefs provides the `fs` fixture via pytest plugin
    "@pip//pytest",
    "@pip//rich",
]

o_py_test(
    name = "label_value_entity_kinds_test",
    srcs = ["label_value_test.py"],
    data = _LABEL_VALUE_TEST_DATA,
    deps = _LABEL_VALUE_TEST_DEPS,
    env = {
        "PYTEST_ADDOPTS": "-k 'TestFolderValue or TestSourceValue or TestTaskValue or TestActionValue or TestUserValue'",
    },
)

