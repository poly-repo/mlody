load("//mlody/core/rule.mlody", "rule")
load("//mlody/common/attrs.mlody", "attr", "validate_attr_value")


def _user_impl(ctx):
    validate_attr_value("groups", ctx.attr.groups, "string_list")

    entity_type = None
    try:
        entity_type = builtins.lookup("type", "mlody-user")
    except:
        entity_type = None

    user_fields = {
        "kind": "user",
        "name": ctx.attr.name,
        "description": ctx.attr.description,
        "groups": list(ctx.attr.groups),
    }
    methods = python.getattr(ctx.attr, "methods", None)
    if methods != None:
        user_fields["methods"] = methods
    if entity_type != None:
        user_fields["_entity_type"] = entity_type

    user_struct = Struct(**user_fields)
    user_struct = builtins.register(ctx.kind, user_struct)
    return user_struct


user = rule(
    implementation = _user_impl,
    kind           = "user",
    attrs          = {
        "groups": attr(type="string_list"),
    },
)
