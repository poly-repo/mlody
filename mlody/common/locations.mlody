location(
    name = "postgres",
    base = rds(db_type="postgres"),
    attrs = {
        "connection_id": attr(type="string", mandatory=False),
        "host": attr(type="string", mandatory=False),
        "database": attr(type="string", mandatory=False),
        "table": attr(type="string", mandatory=False),
        "login": attr(type="string", mandatory=False),
        "password": attr(type="string", mandatory=False),
        "port": attr(type="integer", mandatory=False, default=5432),
    },
)

location(
    name = "remote",
    attrs = {
        "uri": attr(type="string", mandatory=True), # we can do better than string for URIs
    },
)

# derived is basically an internal “computed dataset” location, not a real storage backend like posix, s3, or your new postgres.
# It exists to represent: “this value should be materialized as a cached parquet file by running a SQL fragment over another value.”
# At runtime, that derived location is used for three things:
#    Materialization: derived_source.py (line 67) runs the SQL over the source parquet files and writes a cached parquet output.
#    Traversal: label_value.py (line 1819) detects location.type == "derived" and materializes it before reading rows/fields.
#    Path composition: location_composition.py (line 164) knows how to compose a derived dataset with nested field paths, and location_specs.py (line 131) is the typed adapter for that metadata.
location(
    name = "derived",
    injectable = False,
    attrs = {
        "source_ref":   attr(type="string", mandatory=True),
        "sql_fragment": attr(type="string", mandatory=True),
        "dialect":      attr(type="string", mandatory=True),
        "output_path":  attr(type="string", mandatory=True),
    },
)
