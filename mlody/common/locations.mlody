load("//mlody/core/rule.mlody", "rule")
load("//mlody/common/attrs.mlody", "attr", "extend_attrs", "validate_attr_value")


def _coerce_posix_path_value(path_value):
    if isinstance(path_value, str):
        return [path_value]
    if isinstance(path_value, list):
        return list(path_value)
    if isinstance(path_value, tuple):
        return list(path_value)
    return path_value


def _normalize_location_kwargs(loc_struct, kwargs):
    normalized = dict(kwargs)
    if python.getattr(loc_struct, "type", None) == "posix" and "path" in normalized:
        normalized["path"] = _coerce_posix_path_value(normalized["path"])
    return normalized


def _location_info(location, enclosing):
    _ = enclosing
    return "location: " + location.name


def _effective_location_methods(methods):
    if methods == None:
        return struct(info=_location_info)

    methods_type = type(methods)
    if methods_type == "struct":
        methods_mapping = methods.as_mapping()
    else:
        methods_mapping = methods
    if "info" in methods_mapping:
        return methods

    merged_methods = dict(methods_mapping)
    merged_methods["info"] = _location_info
    return struct(**merged_methods)


def _make_location_factory(loc_struct):
    allowed = python.getattr(loc_struct, "_allowed_attrs", {})
    mandatory = python.getattr(loc_struct, "_attrs_mandatory", set())
    current_attrs = python.getattr(loc_struct, "attributes", {})

    def factory(**kwargs):
        normalized_kwargs = _normalize_location_kwargs(loc_struct, kwargs)

        for k in kwargs:
            if k not in allowed:
                raise TypeError(
                    loc_struct.name + "() got unexpected attribute " + repr(k)
                    + ". Allowed: " + repr(set(allowed))
                )
        for k, v in normalized_kwargs.items():
            validate_attr_value(k, v, allowed[k])

        for k in mandatory:
            if k not in current_attrs and k not in normalized_kwargs:
                raise ValueError(
                    loc_struct.name + "() Missing mandatory argument " + repr(k)
                )

        if not kwargs:
            return loc_struct

        inline_data = None
        location_attributes = dict(normalized_kwargs)
        if python.getattr(loc_struct, "type", None) == "inline" and "data" in location_attributes:
            inline_data = location_attributes.pop("data")

        captured_kwargs = dict(normalized_kwargs)
        def extra_validator(value):
            # v1 unification: equality check per constrained attribute
            for k, expected in captured_kwargs.items():
                actual = value
                if python.getattr(loc_struct, "type", None) == "posix" and k == "path":
                    actual = _coerce_posix_path_value(value)
                    expected = _coerce_posix_path_value(expected)
                if actual != expected:
                    raise ValueError(
                        f"location constraint {k!r} not satisfied: "
                        f"expected {expected!r}, got {actual!r}"
                    )
            return True

        return extend_attrs(
            base=loc_struct,
            extra_attributes=location_attributes,
            extra_validator=extra_validator,
            data=inline_data,
        )

    return factory


def _location_impl(ctx):
    base_type = python.getattr(ctx.attr, 'base', None)
    methods = _effective_location_methods(python.getattr(ctx.attr, "methods", None))

    if base_type == None:
        # No base: bootstrap a minimal no-op base for this location kind.
        base_type = Struct(
            kind="location", type=ctx.attr.name, name=ctx.attr.name,
            attributes={}, _allowed_attrs={},
            validator=lambda v: True,
            abstract=False,
            _root_kind=ctx.attr.name,
        )

    other_fields = {}
    if python.hasattr(ctx.attr, 'description'):
        other_fields['description'] = ctx.attr.description
    if methods != None:
        other_fields["methods"] = methods

    predicate = python.getattr(ctx.attr, 'predicate', None)

    extra_attrs_spec = None
    default_attributes = None
    attrs_mandatory = set()
    if python.hasattr(ctx.attr, 'attrs') and ctx.attr.attrs != None:
        for attr_name, attr_def in ctx.attr.attrs.as_mapping().items():
            declared_type = python.getattr(attr_def, "type", None)
            if declared_type == None:
                raise ValueError(
                    f"location {ctx.attr.name!r}: attrs[{attr_name!r}] must declare a type"
                )
            if extra_attrs_spec == None:
                extra_attrs_spec = {}
            extra_attrs_spec[attr_name] = declared_type
            metadata = python.getattr(attr_def, "metadata", None)
            mandatory = python.getattr(metadata, "mandatory", None) if metadata != None else None
            if mandatory == True:
                attrs_mandatory.add(attr_name)
            default_value = python.getattr(metadata, "default", None) if metadata != None else None
            if default_value != None:
                if default_attributes == None:
                    default_attributes = {}
                default_attributes[attr_name] = default_value
    if attrs_mandatory:
        other_fields["_attrs_mandatory"] = attrs_mandatory

    # Always set abstract explicitly (prevents inheriting True from an abstract base).
    abstract = python.getattr(ctx.attr, 'abstract', None)
    other_fields['abstract'] = abstract == True

    # Anchor _root_kind to this location kind's own name.
    other_fields['_root_kind'] = ctx.attr.name

    new_loc_struct = extend_attrs(
        base=base_type,
        type_name=ctx.attr.name,
        extra_attributes=default_attributes,
        extra_attrs_spec=extra_attrs_spec,
        extra_validator=predicate,
        **other_fields
    )
    new_loc_struct = builtins.register(ctx.kind, new_loc_struct)
    injectable = python.getattr(ctx.attr, 'injectable', True)
    if injectable != False:
        builtins.inject(ctx.attr.name, _make_location_factory(new_loc_struct))
    return {}


location = rule(
    implementation=_location_impl,
    kind='location',
    attrs={
        "base":        attr(type="location", mandatory=False, default=None),
        "attrs":       attr(type="dict",     mandatory=False, default=None),
        "predicate":   attr(type="callable", mandatory=False, default=None),
        "abstract":    attr(type="bool",     mandatory=False, default=None),
        "injectable":  attr(type="bool",     mandatory=False, default=None),
    }
)

location(
    name = "s3",
    attrs = {
        "bucket": attr(type="string", mandatory=False),
        "prefix": attr(type="string", mandatory=False),
        "region": attr(type="string", mandatory=False), # probably only meaningful for AWS S3
	"endpoint": attr(type="string", mandatory=False), # for minio etx
    },
)

location(
    name = "posix",
    attrs = {
        "path": attr(type="string_list", mandatory=False),
    },
)

location(
    name = "git_repository",
    attrs = {
	# should endpoint be called remote as in bazel?
	"endpoint": attr(type="string", mandatory=True),
	# exactly one of the following three shall be specified. Not able to state that with the types we have.
	"branch": attr(type="string", mandatory=False),
	"tag": attr(type="string", mandatory=False),
	"commit": attr(type="string", mandatory=False),

        # we should get a path type. Needed in labels as well.
        "path": attr(type="string", mandatory=False),
        # whether to include submodules
	"submodules": attr(type="bool", mandatory=False),
    },
)

location(
    name = "virtual",
    attrs = {
        "materializer": attr(type="callable", mandatory=True),
    },
)

location(
    name = "named_arg",
    attrs = {
	"flag_name": attr(type="string", mandatory=False),
    },
)

location(
    name = "inline",
    attrs = {
        "data": attr(type="any", mandatory=False),
    },
)

location(
    name = "rds",
    abstract = True,
    attrs = {
        "db_type": attr(type="string", mandatory=False),
    },
)

