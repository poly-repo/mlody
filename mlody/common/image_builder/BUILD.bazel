load("//build/bzl:python.bzl", "o_py_binary", "o_py_library", "o_py_test")

# Core library: errors, logging, output, auth.
# Phases depend on this; it has no internal deps to avoid cycles.
o_py_library(
    name = "image_builder_core",
    srcs = [
        "__init__.py",
        "auth.py",
        "errors.py",
        "log.py",
        "output.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//common/python/errors:errors_lib",  # keep — errors.py imports StructuredError
    ],
)

# Full library: core + phases + pipeline orchestrator.
o_py_library(
    name = "image_builder_lib",
    srcs = [
        "__init__.py",
        "auth.py",
        "errors.py",
        "log.py",
        "output.py",
        "pipeline.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":image_builder_core",  # keep
        "//common/python/errors:errors_lib",
        "//mlody/common:hash_lib",
        "//mlody/common/image_builder/phases:phases_lib",  # keep
    ],
)

# CLI library: exposes __main__ as importable module for testing.
o_py_library(
    name = "cli_lib",
    srcs = ["__main__.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":image_builder_lib",  # keep
        "@pip//click",
    ],
)

o_py_binary(
    name = "mlody_image_builder",
    srcs = ["__main__.py"],
    main = "__main__.py",
    visibility = ["//visibility:public"],
    deps = [
        ":image_builder_lib",  # keep
        "//mlody/common:common_lib",
        "@pip//click",
    ],
)

o_py_test(
    name = "errors_test",
    srcs = ["errors_test.py"],
    deps = [
        ":image_builder_core",  # keep — test imports from mlody.common.image_builder.errors
        "//common/python/errors:errors_lib",  # keep — test imports StructuredError directly
    ],
)
