load("//mlody/core/rule.mlody", "rule")
load("//mlody/common/attrs.mlody", "attr", "field", "extend_attrs", "_make_factory", "validate_attr_value", "_PRIMITIVE_KINDS", "generic_validate", "_builtin_bool", "_builtin_float", "_builtin_tuple", "_PRIMITIVE_VALIDATORS", "_validate_map", "_validate_tuple")


def repr(*, name, type, to_canonical, from_canonical=None):
    """Construct a representation descriptor for use in typedef(representations=[...])."""
    return Struct(
        kind="repr",
        name=name,
        type=type,
        to_canonical=to_canonical,
        from_canonical=from_canonical,
    )


def _is_record_like(type_struct):
    return (
        python.getattr(type_struct, "kind", None) == "record"
        or python.getattr(type_struct, "_root_kind", None) == "record"
    )


def _declared_fields(type_struct):
    attrs = python.getattr(type_struct, "attributes", None)
    attrs_fields = attrs.get("fields") if isinstance(attrs, dict) else None
    direct_fields = python.getattr(type_struct, "fields", None)
    return list(direct_fields or attrs_fields or [])


def _merge_field_declarations(owner_name, existing_fields, new_fields):
    merged = list(existing_fields)
    seen = {python.getattr(f, "name", None) for f in existing_fields}
    for f in new_fields:
        field_name = python.getattr(f, "name", None)
        if field_name in seen:
            raise ValueError(
                "typedef " + str(owner_name) + ": duplicate declared field " + str(field_name)
            )
        merged.append(f)
        seen.add(field_name)
    return merged


def _type_impl(ctx):
    base_type = python.getattr(ctx.attr, 'base', None)
    virtual_attributes = python.getattr(ctx.attr, "virtual_attributes", None)
    declared_fields = python.getattr(ctx.attr, "fields", None)
    methods = python.getattr(ctx.attr, "methods", None)

    merged_record_fields = None
    merged_record_strict = None
    if base_type != None and _is_record_like(base_type):
        inherited_fields = _declared_fields(base_type)
        requested_fields = list(declared_fields or [])
        if requested_fields:
            merged_record_fields = _merge_field_declarations(
                ctx.attr.name,
                inherited_fields,
                requested_fields,
            )
            inherited_attrs = python.getattr(base_type, "attributes", {})
            inherited_strict = inherited_attrs.get("strict") if isinstance(inherited_attrs, dict) else None
            requested_strict = python.getattr(ctx.attr, "strict", None)
            merged_record_strict = requested_strict if requested_strict != None else inherited_strict

    # Handle fields kwarg: per-key map typedef (e.g. typedef(name="point", fields=[field(...)]))
    if declared_fields != None and merged_record_fields == None:
        strict = python.getattr(ctx.attr, "strict", False)
        captured_attrs = {"fields": declared_fields, "strict": strict}
        captured_predicate = python.getattr(ctx.attr, 'predicate', None)
        captured_canonical = python.getattr(ctx.attr, 'canonical', None)
        def _map_validator(value):
            _validate_map(captured_attrs, value)
            if captured_predicate != None:
                res = captured_predicate(value)
                if res == False:
                    raise ValueError("cross-field predicate rejected the value")
            return True
        new_type_struct = Struct(
            kind="type", type=ctx.attr.name, name=ctx.attr.name,
            attributes=captured_attrs, _allowed_attrs={},
            _root_kind="map", validator=_map_validator,
            canonical=captured_canonical,
            virtual_attributes=virtual_attributes,
            methods=methods,
        )
        new_type_struct = builtins.register(ctx.kind, new_type_struct)
        builtins.inject(ctx.attr.name, _make_factory(new_type_struct))
        return {}

    # Handle list base: positional tuple schema (e.g. typedef(name="point", base=[float(), float()]))
    if isinstance(base_type, list):
        for i, item in enumerate(base_type):
            if type(item) != "struct" or python.getattr(item, "kind", None) != "type":
                raise TypeError(
                    f"typedef {ctx.attr.name!r}: base list item {i} must be a type struct"
                )
        element_types = base_type
        captured_attrs = {"_element_types": element_types}
        captured_canonical = python.getattr(ctx.attr, 'canonical', None)
        def _tuple_validator(value):
            _validate_tuple(captured_attrs, value)
            return True
        new_type_struct = Struct(
            kind="type", type=ctx.attr.name, name=ctx.attr.name,
            attributes=captured_attrs, _allowed_attrs={},
            _root_kind="tuple", validator=_tuple_validator,
            canonical=captured_canonical,
            virtual_attributes=virtual_attributes,
            methods=methods,
        )
        new_type_struct = builtins.register(ctx.kind, new_type_struct)
        builtins.inject(ctx.attr.name, _make_factory(new_type_struct))
        return {}

    if base_type == None:
        # No base given: bootstrap a minimal primitive base from the typedef name.
        # Only valid for kinds handled by generic_validate (e.g. "integer", "float").
        base_type = Struct(
            kind="type", type=ctx.attr.name, name=ctx.attr.name,
            attributes={}, _allowed_attrs={},
        )
    other_fields = {}
    if python.hasattr(ctx.attr, 'description'):
        other_fields['description'] = ctx.attr.description
    canonical = python.getattr(ctx.attr, 'canonical', None)
    if canonical != None:
        other_fields['canonical'] = canonical
    canonical_for_attrs = python.getattr(ctx.attr, '_canonical_for_attrs', None)
    if canonical_for_attrs != None:
        other_fields['_canonical_for_attrs'] = canonical_for_attrs
    location = python.getattr(ctx.attr, 'location', None)
    if location != None:
        validate_attr_value("location", location, "location")
        other_fields['location'] = location
    predicate = python.getattr(ctx.attr, 'predicate', None)

    extra_attrs_spec = None
    extra_attributes = None
    attrs_mandatory = set()
    if python.hasattr(ctx.attr, 'attrs') and ctx.attr.attrs != None:
        # ctx.attr.attrs is a Struct (rule.mlody coerces dicts via struct())
        # Each field is itself a Struct: Struct(type="...", metadata=Struct(...))
        for attr_name, attr_def in ctx.attr.attrs.as_mapping().items():
            declared_type = python.getattr(attr_def, "type", None)
            if declared_type == None:
                raise ValueError(
                    f"typedef {ctx.attr.name!r}: attrs[{attr_name!r}] must declare a type"
                )
            if extra_attrs_spec == None:
                extra_attrs_spec = {}
            extra_attrs_spec[attr_name] = declared_type
            is_mandatory = python.getattr(attr_def.metadata, "mandatory", False)
            if is_mandatory:
                attrs_mandatory.add(attr_name)

    if attrs_mandatory:
        other_fields["_attrs_mandatory"] = attrs_mandatory
    if virtual_attributes != None:
        other_fields["virtual_attributes"] = virtual_attributes
    if methods != None:
        other_fields["methods"] = methods
    if merged_record_fields != None:
        extra_attributes = {
            "fields": merged_record_fields,
            "strict": merged_record_strict,
        }

    # Always explicitly set abstract (prevents inheriting True from an abstract base).
    abstract = python.getattr(ctx.attr, 'abstract', None)
    other_fields['abstract'] = abstract == True

    # Primitive bootstrap types must anchor _root_kind to their own name so that
    # generic_validate dispatch still works when the base is abstract.
    if ctx.attr.name in _PRIMITIVE_KINDS:
        other_fields['_root_kind'] = ctx.attr.name

    # Representations: when alternate input forms are declared, build a standalone
    # coercion validator that tries canonical type first, then each repr in order.
    # We cannot use the standard extend_attrs composition here because extend_attrs
    # runs the base validator BEFORE the extra_validator; that would reject repr-form
    # inputs (e.g. a dict passed to a string-based type) before the repr fallback runs.
    # Instead we build the type struct directly, embedding the full coercion algorithm
    # in a single validator closure.
    representations = python.getattr(ctx.attr, "representations", None)
    if representations != None:
        captured_reprs = representations
        captured_base_validator = python.getattr(base_type, "validator", None)
        captured_canonical = python.getattr(ctx.attr, 'canonical', None)
        captured_predicate = predicate
        accepted_forms = ["canonical (" + ctx.attr.name + ")"] + [r.name for r in captured_reprs]

        def _coercion_validator(value):
            canonical_error = None
            repr_error = None
            repr_matched = False
            # Step 1: try canonical type (base validator)
            try:
                if captured_base_validator != None:
                    captured_base_validator(value)
                # Passed the base type check; run predicate if present
                if captured_predicate != None:
                    res = captured_predicate(value)
                    if res == False:
                        raise ValueError("predicate rejected value")
                return True
            except (TypeError, ValueError) as exc:
                canonical_error = exc

            # Step 2: try each repr in declaration order
            for r in captured_reprs:
                repr_validator = python.getattr(r.type, "validator", None)
                try:
                    if repr_validator != None:
                        repr_validator(value)
                except (TypeError, ValueError):
                    continue

                repr_matched = True
                try:
                    canonical_value = r.to_canonical(value)
                    if captured_canonical != None:
                        canonical_value = captured_canonical(canonical_value)
                    if captured_base_validator != None:
                        captured_base_validator(canonical_value)
                    if captured_predicate != None:
                        res = captured_predicate(canonical_value)
                        if res == False:
                            raise ValueError("predicate rejected value")
                    # Matched this repr — coercion succeeds
                    return True
                except (TypeError, ValueError) as exc:
                    repr_error = exc

            # Step 3: nothing matched
            if repr_matched and repr_error != None:
                raise repr_error
            if canonical_error != None and (isinstance(value, dict) or type(value) == "struct"):
                raise canonical_error
            raise TypeError(
                f"Value {value!r} does not match any accepted form for type "
                f"{ctx.attr.name!r}. Accepted: {accepted_forms}"
            )

        # Build the type struct directly: _coercion_validator is the sole gate.
        # Inherit base attributes and allowed_attrs so factory kwargs still work.
        base_map = base_type.as_mapping()
        merged_attrs_for_repr = dict(base_map.get("attributes", {}))
        merged_allowed_for_repr = dict(base_map.get("_allowed_attrs", {}))
        repr_fields = dict(base_map)
        repr_fields["attributes"] = merged_attrs_for_repr
        repr_fields["_allowed_attrs"] = merged_allowed_for_repr
        repr_fields["type"] = ctx.attr.name
        repr_fields["name"] = ctx.attr.name
        repr_fields["validator"] = _coercion_validator
        repr_fields["abstract"] = False
        for k, v in other_fields.items():
            repr_fields[k] = v
        new_type_struct = Struct(**repr_fields)
        new_type_struct = builtins.register(ctx.kind, new_type_struct)
        builtins.inject(ctx.attr.name, _make_factory(new_type_struct))
        return {}

    new_type_struct = extend_attrs(
        base=base_type,
        type_name=ctx.attr.name,
        extra_attributes=extra_attributes,
        extra_attrs_spec=extra_attrs_spec,
        extra_validator=predicate,
        **other_fields
    )
    new_type_struct = builtins.register(ctx.kind, new_type_struct)
    builtins.inject(ctx.attr.name, _make_factory(new_type_struct))
    return {}


typedef = rule(
    implementation=_type_impl,
    kind='type',
    attrs={
        "base":        attr(type="type",       mandatory=False, default=None),
        "attrs":       attr(type="dict",       mandatory=False, default=None),
        "predicate":   attr(type="callable",   mandatory=False, default=None),
        "canonical":            attr(type="callable",   mandatory=False, default=None),
        "_canonical_for_attrs": attr(type="callable",   mandatory=False, default=None),
        "fields":           attr(type="field_list", mandatory=False, default=None),
        "strict":           attr(type="bool",       mandatory=False, default=None),
        "abstract":         attr(type="bool",       mandatory=False, default=None),
        "representations":  attr(type="repr_list",  mandatory=False, default=None),
        "virtual_attributes": attr(type="field_list", mandatory=False, default=None),
        "location":         attr(type="location",   mandatory=False, default=None),
    }
)

# ---- Abstract hierarchy ----
typedef(name="any",       abstract=True) # top
typedef(name="nothing",   abstract=True) # bottom
typedef(name="scalar",    base=any(),       abstract=True)
typedef(name="aggregate", base=any(),       abstract=True)

# ---- Opaque type, the type of values that may have a structure that we do not want to specify
typedef(name="opaque",    base=any())

# ---- Scalar primitives (inherit from scalar) ----
def _coerce_integer_strict(v):
    if isinstance(v, int) and not isinstance(v, _builtin_bool):
        return v
    if isinstance(v, _builtin_float):
        rounded = python.round(v)
        if _builtin_float(rounded) == v:
            return rounded
        raise TypeError(f"Cannot convert non-whole float {v!r} to integer")
    if isinstance(v, str):
        if python.re.fullmatch(r'[+-]?\d+', v.strip()):
            return int(v.strip())
        raise TypeError(f"Cannot parse {v!r} as integer")
    raise TypeError(f"Expected integer, got {type(v)!r}: {v!r}")


def _coerce_integer_lenient(v):
    if isinstance(v, int) and not isinstance(v, _builtin_bool):
        return v
    if isinstance(v, _builtin_float):
        return python.round(v)
    if isinstance(v, str):
        if python.re.fullmatch(r'[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?', v.strip()):
            return python.round(_builtin_float(v.strip()))
        raise TypeError(f"Cannot parse {v!r} as integer")
    raise TypeError(f"Expected integer, got {type(v)!r}: {v!r}")


def _integer_canonical_for_attrs(attrs):
    if attrs.get("strict", True) == False:
        return _coerce_integer_lenient
    return _coerce_integer_strict


typedef(
    name = "integer",
    base = scalar(),
    canonical = _coerce_integer_strict,
    _canonical_for_attrs = _integer_canonical_for_attrs,
    attrs = {
        "min":    attr(type="integer", mandatory=False),
        "max":    attr(type="integer", mandatory=False),
        "strict": attr(type="bool",    mandatory=False),
    },
)
_BOOL_TRUTHY_STRINGS = {"true", "yes", "1"}
_BOOL_FALSY_STRINGS  = {"false", "no", "0"}


def _is_accepted_bool(v):
    if isinstance(v, _builtin_bool):
        return True
    if isinstance(v, str) and v.lower() in _BOOL_TRUTHY_STRINGS:
        return True
    if isinstance(v, str) and v.lower() in _BOOL_FALSY_STRINGS:
        return True
    # Accept integer 0 or 1, but not bool (bool is a subclass of int in Python)
    if isinstance(v, int) and not isinstance(v, _builtin_bool) and v in (0, 1):
        return True
    raise TypeError(
        f"Expected bool-like value (True/False, 'true'/'false'/'yes'/'no'/'1'/'0', "
        f"integer 0 or 1), got {type(v)!r}: {v!r}"
    )


def _coerce_bool(v):
    if isinstance(v, _builtin_bool):
        return v
    if isinstance(v, str):
        if v.lower() in _BOOL_TRUTHY_STRINGS:
            return True
        if v.lower() in _BOOL_FALSY_STRINGS:
            return False
        raise TypeError(
            f"Expected bool-like string ('true'/'false'/'yes'/'no'/'1'/'0'), got {v!r}"
        )
    if isinstance(v, int) and not isinstance(v, _builtin_bool) and v in (0, 1):
        return v == 1
    raise TypeError(
        f"Expected bool-like value (True/False, 'true'/'false'/'yes'/'no'/'1'/'0', "
        f"integer 0 or 1), got {type(v)!r}: {v!r}"
    )


typedef(
    name      = "bool",
    base      = scalar(),
    predicate = _is_accepted_bool,
    canonical = _coerce_bool,
)
def _coerce_float(v):
    if isinstance(v, _builtin_float):
        return v
    if isinstance(v, int) and not isinstance(v, _builtin_bool):
        return _builtin_float(v)
    if isinstance(v, str):
        if python.re.fullmatch(r'[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?', v.strip()):
            return _builtin_float(v.strip())
        raise TypeError(f"Cannot parse {v!r} as float")
    raise TypeError(f"Expected float, got {type(v)!r}: {v!r}")


typedef(
    name = "float",
    base = scalar(),
    canonical = _coerce_float,
    attrs = {
        "min": attr(type="float", mandatory=False),
        "max": attr(type="float", mandatory=False),
    },
)

# ---- Aggregate types (inherit from aggregate) ----
typedef(
    name = "vector",
    base = aggregate(),
    attrs = {
        "element_type": attr(type="type_ref", mandatory=False),
        "min_length":   attr(type="integer", mandatory=False),
        "max_length":   attr(type="integer", mandatory=False),
    },
)

typedef(name="tuple", base=aggregate())

typedef(
    name = "record",
    base = aggregate(),
    attrs = {
        "fields": attr(type="field_list", mandatory=False),
        "strict":  attr(type="bool",       mandatory=False),
    },
)

typedef(
    name = "map",
    base = aggregate(),
    attrs = {
        "key_type":   attr(type="type",       mandatory=False),
        "value_type": attr(type="type",       mandatory=False),
        "fields":     attr(type="field_list", mandatory=False),
        "strict":     attr(type="bool",       mandatory=False),
    },
)

# ---- String inherits from vector (sequence-like) ----
# min_length/max_length are inherited from vector; only pattern is new.
typedef(
    name = "string",
    base = vector(),
    attrs = {
        "pattern": attr(type="string", mandatory=False),
    },
)

typedef(
    name = "enum",
    base = string(),
    attrs = {
	"values": attr(type="string_list", mandatory=True),
    }
)

_POSIX_PATH_RE = r"(?:/|/?(?:(?!\.{1,2}(?:/|$))[^/]+)(?:/(?:(?!\.{1,2}(?:/|$))[^/]+))*/?)"

typedef(
    name = "posix_path",
    base = string(pattern=_POSIX_PATH_RE),
)


def _uri_is_valid(value):
    parsed = python.parse_uri(value)
    scheme = parsed.get("scheme")
    if not isinstance(scheme, str) or scheme == "":
        raise TypeError("uri scheme must not be empty")
    return True


typedef(
    name = "uri",
    base = string(),
    predicate = _uri_is_valid,
    canonical = lambda value: python.format_uri(python.parse_uri(value)),
    attrs = {
        "scheme":   attr(type="string", mandatory=False),
        "host":     attr(type="string", mandatory=False),
        "port":     attr(type=integer(min=1, max=65535), mandatory=False),
        "path":     attr(type="posix_path", mandatory=False),
        "query":    attr(type="string", mandatory=False),
        "fragment": attr(type="string", mandatory=False),
        "username": attr(type="string", mandatory=False),
        "password": attr(type="string", mandatory=False),
    },
)


# ---- Domain scalar types ----

_FULL_SHA_RE  = python.re.compile(r'^[0-9a-f]{40}$')
_SHORT_SHA_RE = python.re.compile(r'^[0-9a-f]{4,39}$')

def _is_valid_commit_sha(value):
    if isinstance(value, str) and (
        _FULL_SHA_RE.match(value) or _SHORT_SHA_RE.match(value)
    ):
        return True
    raise TypeError(
        "commit-sha must be a 40-char hex string or a resolvable short SHA, got " + str(value)
    )

def _canonical_commit_sha(value):
    return python.expand_commit_sha(value)

typedef(
    name      = "commit",
    base      = string(),
    predicate = _is_valid_commit_sha,
    canonical = _canonical_commit_sha,
)

# ---- mlody built-in types ----
typedef(
    name = "mlody-source-range",
    base = record(fields = [
        field(name = "filepath",   type = string()),
        field(name = "start_line", type = integer()),
        field(name = "end_line",   type = integer()),
    ]),
)

typedef(
    name = "mlody-lineage-event",
    base = record(fields = [
        field(name = "source",    type = string(), mandatory = False),
        field(name = "reason",    type = string(), mandatory = False),
        field(name = "timestamp", type = string(), mandatory = False),
        field(name = "accessor",  type = string(), mandatory = False),
        field(name = "mode",      type = string(), mandatory = False),
        field(name = "details",   type = any(),    mandatory = False),
        field(name = "new_value", type = any(),    mandatory = False),
    ]),
)

typedef(
    name = "mlody-entity",
    base = record(fields = [
        field(
            name = "_source_range",
            type = builtins.lookup("type", "mlody-source-range"),
            mandatory = False,
        ),
        field(
            name = "raw",
            type = string(),
            materializer = lambda owner: python.runtime_json_blob(owner),
        ),
    ]),
    virtual_attributes = [
        field(
            name = "lineage",
            type = vector(element_type=":mlody-lineage-event"),
            materializer = lambda owner: python.getattr(owner, "_lineage", []),
            mandatory = False,
        ),
    ],
)

typedef(
    name = "mlody-value",
    base = builtins.lookup("type", "mlody-entity"),
)

typedef(
    name = "mlody-task",
    base = builtins.lookup("type", "mlody-entity"),
    fields = [
        field(
            name = "_hash",
            type = string(),
            materializer = lambda _task: python.uuid7(),
        ),
    ],
)

typedef(
    name = "mlody-action",
    base = builtins.lookup("type", "mlody-entity"),
)

typedef(
    name = "mlody-user",
    base = builtins.lookup("type", "mlody-entity"),
    fields = [
        field(name = "avatar", type = string(), mandatory = False),
    ],
)

typedef(
    name = "mlody-root",
    base = builtins.lookup("type", "mlody-entity"),
)

typedef(
    name = "mlody_workspace_info",
    base = record(fields = [
        field(name = "path",          type = string()),
        field(name = "branch",        type = string()),
        field(name = "sha",           type = string()),
        field(name = "roots",         type = vector(element_type=string())),
        field(name = "user",          type = string()),
        field(name = "modified_files",  type = int()),
        field(name = "untracked_files", type = int()),
    ]),
)

typedef(
    name = "mlody-workspace",
    base = builtins.lookup("type", "mlody-entity"),
    description = "A snapshot of an mlody workspace.",
    fields = [
        field(name = "info", type = mlody_workspace_info()),
    ],
)

typedef(
    name = "mlody-folder",
    description = "A file system folder containing mlody source files or other mlody folders.",
    base = record(fields = [
        field(name = "subfolders", type = vector(element_type=":mlody-folder")),
        field(name = "files",      type = vector(element_type=":mlody-source")),
    ]),
)

typedef(
    name = "mlody-source",
    description = "A mlody source file containing mlody entities.",
    base = record(fields = [
        field(name = "entities", type = map(key_type=string())),
    ]),
)
