load("//mlody//core/rule.mlody", "rule")
load("//mlody/common/attrs.mlody", "attr", "validate_attr_value")
load("//mlody/common/freshness.mlody")


_CONTEXTUAL_VALUE_ATTRS = {
    "group": attr(
        type="string",
        mandatory=False,
        allowed_in=["task.outputs"],
    ),
    "constraint": attr(
        type="string",
        mandatory=False,
        allowed_in=["task.config", "task.action.config"],
    ),
}

_SOURCE_ALLOWED_IN = [
    "standalone",
    "task.inputs",
    "task.config",
    "task.action.inputs",
    "task.action.config",
]

_SOURCE_ATTR = attr(
    type="value_ref",
    mandatory=False,
    allowed_in=_SOURCE_ALLOWED_IN,
)

_NUMERIC_VALUE_TYPE_ROOTS = ("integer", "float")


def _resolve_ref(value, kind):
    """Resolve a string name or validate an already-resolved struct of the given kind."""
    if isinstance(value, str):
        return builtins.lookup(kind, value)
    if type(value) == "struct":
        got_kind = python.getattr(value, "kind", None)
        if got_kind != kind:
            got_t = python.getattr(value, "type", None)
            raise TypeError(
                "Expected a " + kind + " struct (kind='" + kind + "'), got a "
                + repr(got_kind) + " struct"
                + (" of type " + repr(got_t) if got_t != None else "")
            )
        return value
    raise TypeError(
        "Expected a " + kind + " struct or string name, got " + repr(type(value))
    )


def _resolve_type_ref(value):
    return _resolve_ref(value, "type")


def _resolve_location_ref(value):
    return _resolve_ref(value, "location")


def _resolve_freshness_ref(value):
    return _resolve_ref(value, "freshness")


def _resolve_source_ref(value):
    if isinstance(value, str):
        # Mlody label — kept as-is; resolved lazily during DAG building.
        return value
    if type(value) == "struct":
        got_kind = python.getattr(value, "kind", None)
        if got_kind != "value":
            got_t = python.getattr(value, "type", None)
            raise TypeError(
                "Expected a value struct (kind='value') or mlody label string, got a "
                + repr(got_kind) + " struct"
                + (" of type " + repr(got_t) if got_t != None else "")
            )
        return value
    raise TypeError(
        "Expected a value struct or mlody label string, got " + repr(type(value))
    )


def _lookup_value_if_registered(value):
    if value == None:
        return None
    if type(value) == "struct":
        return value
    if isinstance(value, str):
        try:
            return builtins.lookup("value", value)
        except:
            return None
    return None


def _lineage_event(source, timestamp, reason):
    """Create a single lineage event struct.

    Args:
        source:    string — who/what generated this event (e.g. "mlody")
        timestamp: string — ISO-8601 or unix epoch as string
        reason:    string — why this event occurred (one of a fixed set, TBD)
    """
    return struct(
        kind="lineage_event",
        source=source,
        timestamp=timestamp,
        reason=reason,
    )


def _resolve_representation_ref(value):
    if type(value) == "struct":
        got_kind = python.getattr(value, "kind", None)
        if got_kind != "representation":
            raise TypeError(
                "Expected a representation struct (kind='representation'), got a "
                + repr(got_kind) + " struct"
            )
        return value
    raise TypeError(
        "Expected a representation struct, got " + repr(type(value))
    )


def _extract_source_query(source_raw):
    """Return (clean_label, dialect, sql_fragment) when source_raw carries a
    query suffix, else (source_raw, None, None).

    A query suffix is a bracket expression whose content starts with '@sql '.
    Only string labels are inspected; struct sources pass through unchanged.
    """
    if not isinstance(source_raw, str):
        return source_raw, None, None
    bracket_pos = source_raw.find("[")
    if bracket_pos == -1:
        return source_raw, None, None
    if not source_raw.endswith("]"):
        return source_raw, None, None
    clean_label = source_raw[:bracket_pos]
    inner = source_raw[bracket_pos + 1:-1]
    _SQL_PREFIX = "@sql "
    if not inner.startswith(_SQL_PREFIX):
        return source_raw, None, None
    sql_fragment = inner[len(_SQL_PREFIX):]
    return clean_label, "duckdb", sql_fragment


def _type_root_kind(type_ref):
    root_kind = python.getattr(type_ref, "_root_kind", None)
    if root_kind != None:
        return root_kind
    return python.getattr(type_ref, "type", None)


def _parse_value_unit(unit_raw, type_ref):
    validate_attr_value("unit", unit_raw, "string")
    type_root = _type_root_kind(type_ref)
    if type_root not in _NUMERIC_VALUE_TYPE_ROOTS:
        type_name = python.getattr(type_ref, "name", python.getattr(type_ref, "type", None))
        raise TypeError(
            "unit= is only allowed for numeric value types rooted in "
            + repr(_NUMERIC_VALUE_TYPE_ROOTS)
            + ", got "
            + repr(type_name)
        )
    try:
        return python.parse_astropy_unit(unit_raw)
    except ValueError as exc:
        raise ValueError("Invalid unit " + repr(unit_raw) + ": " + str(exc))


def clone_value(value_struct, **overrides):
    if type(value_struct) != "struct" or python.getattr(value_struct, "kind", None) != "value":
        raise TypeError("clone_value expects a value struct")
    fields = dict(value_struct.as_mapping())
    for key, value in overrides.items():
        fields[key] = value
    return Struct(**fields)


def _contextual_value_fields(ctx_attr):
    fields = {}
    policies = {}
    for attr_name, attr_def in _CONTEXTUAL_VALUE_ATTRS.items():
        if not python.hasattr(ctx_attr, attr_name):
            continue
        attr_value = python.getattr(ctx_attr, attr_name, None)
        if attr_value == None:
            continue
        validate_attr_value(attr_name, attr_value, attr_def.get("type"))
        fields[attr_name] = attr_value
        policies[attr_name] = _policy_tuple(attr_def)
    if policies:
        fields["_context_attr_policies"] = policies
    return fields


def _policy_tuple(attr_def):
    metadata = attr_def.get("metadata", {})
    allowed_in = metadata.get("allowed_in", [])
    return tuple(allowed_in)


def _merge_context_policy(value_fields, attr_name, attr_def):
    existing = value_fields.get("_context_attr_policies", {})
    merged = dict(existing)
    merged[attr_name] = _policy_tuple(attr_def)
    value_fields["_context_attr_policies"] = merged


def _value_rule_attrs():
    attrs = {
        "type":           attr(type="type_ref", mandatory=False),
        "location":       attr(type="location_ref", mandatory=False),
        "freshness":      attr(type="freshness_ref", mandatory=False),
        "unit":           attr(type="string", mandatory=False),
        "default":        attr(mandatory=False),
        "source":         _SOURCE_ATTR,
        "representation": attr(type="representation_ref", mandatory=False),
    }
    for attr_name, attr_def in _CONTEXTUAL_VALUE_ATTRS.items():
        attrs[attr_name] = attr_def
    return attrs


def _value_impl(ctx):
    type_raw = python.getattr(ctx.attr, "type", None)
    loc_raw = python.getattr(ctx.attr, "location", None)
    freshness_raw = python.getattr(ctx.attr, "freshness", None)
    unit_raw = python.getattr(ctx.attr, "unit", None)
    default_raw = python.getattr(ctx.attr, "default", None)
    source_raw = python.getattr(ctx.attr, "source", None)
    rep_raw = python.getattr(ctx.attr, "representation", None)
    source_value = None

    # Detect @sql query suffix on source label and extract components.
    clean_source, sql_dialect, sql_fragment = _extract_source_query(source_raw)

    if sql_fragment != None:
        # A query-bearing source is mutually exclusive with an explicit location.
        if loc_raw != None:
            raise ValueError(
                "location= and a query-bearing source= are mutually exclusive. "
                "Remove the explicit location= or drop the [@sql ...] suffix from source=."
            )

        # Compute deterministic cache path: SHA-256 over
        # '<source_label>:<dialect>:<sql_fragment>', first 40 hex chars.
        raw_key = clean_source + ":" + sql_dialect + ":" + sql_fragment
        hash_hex = python.hashlib.sha256(raw_key.encode()).hexdigest()[:40]
        # Build the full cache path.  Use python.os to expand ~ to the actual
        # home directory (os is not available as a bare name in the sandbox).
        home_path = python.os.path.expanduser("~")
        output_path = home_path + "/.cache/mlody/derived/" + hash_hex + ".parquet"

        source_ref = _resolve_source_ref(clean_source) if clean_source != None else None
        # Collect base source paths from the resolved source value's location so
        # that compose_location can join them with field paths during traversal.
        # source_ref is a lazy string label; resolve eagerly here for metadata only.
        source_value = builtins.lookup("value", clean_source) if clean_source != None else None
        _source_loc = python.getattr(source_value, "location", None) if source_value != None else None
        _source_loc_attrs = python.getattr(_source_loc, "attributes", None) if _source_loc != None else None
        if isinstance(_source_loc_attrs, dict):
            _raw_path = _source_loc_attrs.get("path")
        else:
            _raw_path = python.getattr(_source_loc, "path", None) if _source_loc != None else None
        _source_paths = list(_raw_path) if isinstance(_raw_path, list) else ([_raw_path] if _raw_path != None else [])

        # Construct the derived location struct directly.  The attributes dict
        # must remain a plain Python dict (not coerced to Struct by struct())
        # so that callers can use attributes.get("field") consistently with how
        # other location kinds store their attributes via extend_attrs/Struct.
        loc_ref = Struct(
            kind="location",
            type="derived",
            name="derived",
            abstract=False,
            _root_kind="derived",
            attributes={
                "source_ref": clean_source,
                "source_paths": _source_paths,
                "sql_fragment": sql_fragment,
                "dialect": sql_dialect,
                "output_path": output_path,
            },
        )
    else:
        source_ref = _resolve_source_ref(source_raw) if source_raw != None else None
        source_value = _lookup_value_if_registered(source_ref)
        loc_ref = _resolve_location_ref(loc_raw) if loc_raw != None else None
        if loc_ref == None:
            loc_ref = builtins.lookup("location", "inline")
    freshness_ref = _resolve_freshness_ref(freshness_raw) if freshness_raw != None else None
    if freshness_ref == None:
        freshness_ref = builtins.lookup("freshness", "always")

    allowed_locations_for_default = ["inline", "named_arg"]
    if default_raw != None and python.getattr(loc_ref, "type", None) not in allowed_locations_for_default:
        raise ValueError(
            f"default= is only allowed on values with location={allowed_locations_for_default}. "
            "Remove default= or set location appropriately."
        )

    type_ref = _resolve_type_ref(type_raw) if type_raw != None else None
    # Inherit type from source when not explicitly specified (e.g. derived values
    # should have the same type and layout as their source).
    if type_ref == None and source_ref != None:
        if source_value == None:
            source_value = _lookup_value_if_registered(source_ref)
        type_ref = python.getattr(source_value, "type", None) if source_value != None else None
    if type_ref == None:
        type_ref = builtins.lookup("type", "nothing")

    # Parse unit early so it is available for quantity-string default parsing.
    unit_ref = None
    if unit_raw != None:
        unit_ref = _parse_value_unit(unit_raw, type_ref)

    if default_raw != None:
        if unit_ref != None and isinstance(default_raw, str):
            default_raw = python.parse_quantity_string(default_raw, unit_ref)
        _default_canonical = python.getattr(type_ref, "canonical", None)
        if _default_canonical != None:
            default_raw = _default_canonical(default_raw)
        _default_validator = python.getattr(type_ref, "validator", None)
        if _default_validator != None:
            _default_validator(default_raw)

    rep_ref = _resolve_representation_ref(rep_raw) if rep_raw != None else None
    entity_type = None
    try:
        entity_type = builtins.lookup("type", "mlody-value")
    except:
        entity_type = None

    value_fields = {
        "kind": "value",
        "name": ctx.attr.name,
        "type": type_ref,
        "location": loc_ref,
        "freshness": freshness_ref,
        "unit": unit_ref,
        "default": default_raw,
        "source": source_ref,
        "representation": rep_ref,
        "_lineage": [],          # managed by MLody, not the user
    }
    if entity_type != None:
        value_fields["_entity_type"] = entity_type
    if source_value != None:
        value_fields["_source_value"] = source_value
    for field_name, field_value in _contextual_value_fields(ctx.attr).items():
        value_fields[field_name] = field_value
    if source_raw != None:
        _merge_context_policy(value_fields, "source", _SOURCE_ATTR)

    value_struct = Struct(**value_fields)
    builtins.register(ctx.kind, value_struct)
    return value_struct


value = rule(
    implementation=_value_impl,
    kind="value",
    attrs=_value_rule_attrs(),
)
