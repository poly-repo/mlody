load("//mlody/core/rule.mlody", "rule")
load("//mlody/common/attrs.mlody", "attr")


def _resolve_ref(value, kind):
    """Resolve a string name or validate an already-resolved struct of the given kind."""
    if isinstance(value, str):
        return builtins.lookup(kind, value)
    if type(value) == "struct":
        got_kind = python.getattr(value, "kind", None)
        if got_kind != kind:
            got_t = python.getattr(value, "type", None)
            raise TypeError(
                "Expected a " + kind + " struct (kind='" + kind + "'), got a "
                + repr(got_kind) + " struct"
                + (" of type " + repr(got_t) if got_t != None else "")
            )
        return value
    raise TypeError(
        "Expected a " + kind + " struct or string name, got " + repr(type(value))
    )


def _resolve_type_ref(value):
    return _resolve_ref(value, "type")


def _resolve_location_ref(value):
    return _resolve_ref(value, "location")


def _resolve_source_ref(value):
    return _resolve_ref(value, "value")


def _lineage_event(author, timestamp, reason):
    """Create a single lineage event struct.

    Args:
        author:    string — who/what generated this event (e.g. "mlody")
        timestamp: string — ISO-8601 or unix epoch as string
        reason:    string — why this event occurred (one of a fixed set, TBD)
    """
    return struct(
        kind="lineage_event",
        author=author,
        timestamp=timestamp,
        reason=reason,
    )


def _resolve_representation_ref(value):
    if type(value) == "struct":
        got_kind = python.getattr(value, "kind", None)
        if got_kind != "representation":
            raise TypeError(
                "Expected a representation struct (kind='representation'), got a "
                + repr(got_kind) + " struct"
            )
        return value
    raise TypeError(
        "Expected a representation struct, got " + repr(type(value))
    )


def _extract_source_query(source_raw):
    """Return (clean_label, dialect, sql_fragment) when source_raw carries a
    query suffix, else (source_raw, None, None).

    A query suffix is a bracket expression whose content starts with '@sql '.
    Only string labels are inspected; struct sources pass through unchanged.
    """
    if not isinstance(source_raw, str):
        return source_raw, None, None
    bracket_pos = source_raw.find("[")
    if bracket_pos == -1:
        return source_raw, None, None
    if not source_raw.endswith("]"):
        return source_raw, None, None
    clean_label = source_raw[:bracket_pos]
    inner = source_raw[bracket_pos + 1:-1]
    _SQL_PREFIX = "@sql "
    if not inner.startswith(_SQL_PREFIX):
        return source_raw, None, None
    sql_fragment = inner[len(_SQL_PREFIX):]
    return clean_label, "duckdb", sql_fragment


def _value_impl(ctx):
    type_raw = python.getattr(ctx.attr, "type", None)
    loc_raw = python.getattr(ctx.attr, "location", None)
    default_raw = python.getattr(ctx.attr, "default", None)
    source_raw = python.getattr(ctx.attr, "source", None)
    rep_raw = python.getattr(ctx.attr, "representation", None)

    # Detect @sql query suffix on source label and extract components.
    clean_source, sql_dialect, sql_fragment = _extract_source_query(source_raw)

    if sql_fragment != None:
        # A query-bearing source is mutually exclusive with an explicit location.
        if loc_raw != None:
            raise ValueError(
                "location= and a query-bearing source= are mutually exclusive. "
                "Remove the explicit location= or drop the [@sql ...] suffix from source=."
            )

        # Compute deterministic cache path: SHA-256 over
        # '<source_label>:<dialect>:<sql_fragment>', first 40 hex chars.
        raw_key = clean_source + ":" + sql_dialect + ":" + sql_fragment
        hash_hex = python.hashlib.sha256(raw_key.encode()).hexdigest()[:40]
        # Build the full cache path.  Use python.os to expand ~ to the actual
        # home directory (os is not available as a bare name in the sandbox).
        home_path = python.os.path.expanduser("~")
        output_path = home_path + "/.cache/mlody/derived/" + hash_hex + ".parquet"

        source_ref = _resolve_source_ref(clean_source) if clean_source != None else None
        # Collect base source paths from the resolved source value's location so
        # that compose_location can join them with field paths during traversal.
        _source_loc = python.getattr(source_ref, "location", None) if source_ref != None else None
        _source_loc_attrs = python.getattr(_source_loc, "attributes", None) if _source_loc != None else None
        if isinstance(_source_loc_attrs, dict):
            _raw_path = _source_loc_attrs.get("path")
        else:
            _raw_path = python.getattr(_source_loc, "path", None) if _source_loc != None else None
        _source_paths = list(_raw_path) if isinstance(_raw_path, list) else ([_raw_path] if _raw_path != None else [])

        # Construct the derived location struct directly.  The attributes dict
        # must remain a plain Python dict (not coerced to Struct by struct())
        # so that callers can use attributes.get("field") consistently with how
        # other location kinds store their attributes via extend_attrs/Struct.
        loc_ref = Struct(
            kind="location",
            type="derived",
            name="derived",
            abstract=False,
            _root_kind="derived",
            attributes={
                "source_ref": clean_source,
                "source_paths": _source_paths,
                "sql_fragment": sql_fragment,
                "dialect": sql_dialect,
                "output_path": output_path,
            },
        )
    else:
        source_ref = _resolve_source_ref(source_raw) if source_raw != None else None
        loc_ref = _resolve_location_ref(loc_raw) if loc_raw != None else None

    type_ref = _resolve_type_ref(type_raw) if type_raw != None else None
    # Inherit type from source when not explicitly specified (e.g. derived values
    # should have the same type and layout as their source).
    if type_ref == None and source_ref != None:
        type_ref = python.getattr(source_ref, "type", None)
    rep_ref = _resolve_representation_ref(rep_raw) if rep_raw != None else None

    value_struct = Struct(
        kind="value",
        name=ctx.attr.name,
        type=type_ref,
        location=loc_ref,
        default=default_raw,
        source=source_ref,
        representation=rep_ref,
        _lineage=[],          # managed by MLody, not the user
    )
    builtins.register(ctx.kind, value_struct)
    return value_struct


value = rule(
    implementation=_value_impl,
    kind="value",
    attrs={
        "type":           attr(type="type_ref", mandatory=False),
        "location":       attr(type="location_ref", mandatory=False),
        "default":        attr(mandatory=False),
        "source":         attr(type="value_ref", mandatory=False),
        "representation": attr(type="representation_ref", mandatory=False),
    },
)
