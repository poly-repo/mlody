# hash.mlody — semantic content-hash generic for mlody entities and values.
#
# `hash(value)` is intentionally not Python's object hash. The default
# implementation returns None. Value hashing delegates to the Python asset
# layer for remote-like values and source-backed local copies so freshness and
# materialization semantics stay centralized. Task hashing is also implemented
# in Python because it needs deterministic repo-state and dependency hashing.

load("//mlody/common/mm.mlody", "mm", "defmethod")


def _hash_value(ctx, value):
    _ = ctx
    return python.hash(value)


def _hash_task(ctx, task):
    _ = ctx
    return python.hash(task)


def _hash_default(ctx, value):
    _ = (ctx, value)
    return None


hash = mm.generic(
    "hash",
    description="Return a semantic content hash when one is available.",
)

defmethod(hash, [mm.value()], _hash_value)
defmethod(hash, [mm.task()], _hash_task)
defmethod(hash, [mm.ANY], _hash_default)
