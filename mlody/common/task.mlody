load("//mlody/core/rule.mlody", "rule")
load("//mlody/common/attrs.mlody", "attr")
load("//mlody/common/types.mlody", "typedef")
load("//mlody/common/values.mlody", "clone_value")


def _validate_value_refs(attr_name, items):
    for item in items:
        if not isinstance(item, str) and not (type(item) == "struct" and python.getattr(item, "kind", None) == "value"):
            raise TypeError(
                attr_name + ": expected a value struct or string label, got "
                + repr(type(item))
            )
    return list(items)


def _is_action_ref(value):
    return isinstance(value, str) or (type(value) == "struct" and python.getattr(value, "kind", None) == "action")



def _validate_action_ref(value):
    if not _is_action_ref(value):
        raise TypeError(
            "Expected an action struct or string name, got " + repr(type(value))
        )
    return value



def _validate_grouped_action_map(value):
    mapping = _as_dict_or_none(value)
    if mapping == None:
        raise TypeError(
            "Expected an action struct, string name, or dict of output-group -> action ref, got "
            + repr(type(value))
        )

    normalized = {}
    for group_name, action_ref in mapping.items():
        if not isinstance(group_name, str) or group_name == "":
            raise TypeError(
                "action: grouped action keys must be non-empty strings, got "
                + repr(group_name)
            )
        if not _is_action_ref(action_ref):
            raise TypeError(
                "action["
                + repr(group_name)
                + "]: expected an action struct or string name, got "
                + repr(type(action_ref))
            )
        normalized[group_name] = action_ref
    return normalized



def _validate_task_action(value):
    if _is_action_ref(value):
        return _validate_action_ref(value)
    return _validate_grouped_action_map(value)



def _resolve_action_ref(value):
    if not isinstance(value, str):
        return value
    try:
        return builtins.lookup("action", value)
    except:
        return value



def _resolve_task_action(value):
    if isinstance(value, dict):
        return {
            group_name: _resolve_action_ref(action_ref)
            for group_name, action_ref in value.items()
        }
    return _resolve_action_ref(value)



def _is_value_struct(v):
    return type(v) == "struct" and python.getattr(v, "kind", None) == "value"


def _as_dict_or_none(v):
    if v == None:
        return None
    if isinstance(v, dict):
        return v
    as_mapping = python.getattr(v, "as_mapping", None)
    if callable(as_mapping):
        try:
            return dict(as_mapping())
        except:
            return None
    try:
        return dict(v)
    except:
        return None



def _task_impl(ctx):
    inputs_raw = python.getattr(ctx.attr, "inputs", [])
    if inputs_raw == None:
        inputs_raw = []
    inputs  = _validate_value_refs("inputs", inputs_raw)
    outputs = _validate_value_refs("outputs", ctx.attr.outputs)
    action  = _validate_task_action(ctx.attr.action)
    config_raw = python.getattr(ctx.attr, "config", [])
    if config_raw == None:
        config_raw = []
    config = _validate_value_refs("config", config_raw)
    execution_raw = python.getattr(ctx.attr, "execution", None)
    if execution_raw != None:
        if not isinstance(execution_raw, str):
            if type(execution_raw) != "struct" or python.getattr(execution_raw, "kind", None) != "execution":
                raise TypeError(
                    "execution: expected an execution struct or string name, got "
                    + repr(type(execution_raw))
                )
    execution = execution_raw

    resolved_action = _resolve_task_action(action)
    entity_type = None
    try:
        entity_type = builtins.lookup("type", "mlody-task")
    except:
        entity_type = None

    task_fields = {
        "kind": "task",
        "name": ctx.attr.name,
        "description": ctx.attr.description,
        "inputs": inputs,
        "outputs": outputs,
        "action": resolved_action,
        "config": config,
        "execution": execution,
    }
    methods = python.getattr(ctx.attr, "methods", None)
    if methods != None:
        task_fields["methods"] = methods
    if entity_type != None:
        task_fields["_entity_type"] = entity_type

    task_struct = Struct(
        **task_fields,
    )
    task_struct = builtins.register(ctx.kind, task_struct)

    def _register_scoped_value(prefix, v):
        if type(v) == "struct" and python.getattr(v, "kind", None) == "value":
            scoped = clone_value(
                v,
                name=prefix + "." + python.getattr(v, "name", ""),
            )
            builtins.register("value", scoped)

    # Register task-scoped values: {task}.{port}
    task_prefix = ctx.attr.name
    for v in inputs + outputs:
        _register_scoped_value(task_prefix, v)

    # Register action-scoped values: {action}.{port}
    registered_action_names = {}

    def _register_action_ports(action_value):
        if type(action_value) != "struct" or python.getattr(action_value, "kind", None) != "action":
            return
        action_prefix = python.getattr(action_value, "name", "")
        if action_prefix in registered_action_names:
            return
        registered_action_names[action_prefix] = True
        for v in python.getattr(action_value, "inputs", []) + python.getattr(action_value, "outputs", []):
            _register_scoped_value(action_prefix, v)

    if isinstance(resolved_action, dict):
        for action_value in resolved_action.values():
            _register_action_ports(action_value)
    else:
        _register_action_ports(resolved_action)

    return task_struct


task = rule(
    implementation = _task_impl,
    kind           = "task",
    attrs          = {
        "inputs":   attr(type="value_ref_list", mandatory=False),
        "outputs":  attr(type="value_ref_list"),
        "action":   attr(),
        "config":   attr(type="value_ref_list", mandatory=False),
        "execution": attr(type="execution_ref", mandatory=False, default=None),
    },
)
