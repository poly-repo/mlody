load("//mlody/common/types.mlody", "bool", "float", "integer", "opaque", "record", "string", "typedef", "vector")
load("//mlody/common/locations.mlody", "posix", "remote")
load("//mlody/common/freshness.mlody", "ttl")
load("//mlody/common/values.mlody")
load("//mlody/common/action.mlody")
load("//mlody/common/task.mlody")
load("//mlody/common/execution.mlody", "localhost")
load("//mlody/common/representation.mlody", "csv", "html", "json")

# Supported today:
# - cache the source HTML page
# - derive a CSV by reading the first HTML table on demand
# The downstream tasks are kept in place because we plan to add task execution.

cached_value(
    name = "country-stats-page",
    type = opaque(),
    source = remote(uri = "https://tinyurl.com/mry64ebh"),
    location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats_page.html"),
    representation = html(),
    freshness = ttl(duration = "1day"),
)

typedef(
    name = "country-stats-row",
    base = record(
        fields = [
            value(name = "country", type = string()),
            value(name = "pop_2022", type = integer()),
            value(name = "pop_2023", type = integer()),
            value(name = "continent", type = string()),
            value(name = "region", type = string()),
            value(name = "pop_change", type = float()),
        ],
    ),
)

value(
    name = "country-stats",
    type = vector(element_type = ":country-stats-row"),
    source = ":country-stats-page",
    location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats.csv"),
    representation = csv(schema = ":country-stats-row"),
)

typedef(
    name = "country-stats-check-report",
    base = record(
        fields = [
            value(name = "passed", type = bool()),
            value(name = "row_count", type = integer()),
            value(name = "checked_columns", type = vector(element_type = string())),
            value(name = "message", type = string()),
        ],
    ),
)

typedef(
    name = "continent-coefficient",
    base = record(
        fields = [
            value(name = "continent", type = string()),
            value(name = "coefficient", type = float()),
        ],
    ),
)

typedef(
    name = "population-change-model",
    base = record(
        fields = [
            value(name = "intercept", type = float()),
            value(name = "coefficients", type = vector(element_type = ":continent-coefficient")),
            value(name = "r2_score", type = float()),
            value(name = "rmse", type = float()),
            value(name = "mae", type = float()),
            value(name = "num_training_samples", type = integer()),
        ],
    ),
)

typedef(
    name = "continent-stats-row",
    base = record(
        fields = [
            value(name = "continent", type = string()),
            value(name = "pop_2022", type = integer()),
            value(name = "pop_2023", type = integer()),
            value(name = "pop_change", type = float()),
            value(name = "pop_change_factor", type = float()),
        ],
    ),
)

task(
    name = "check_country_stats",
    inputs = [
        value(
            name = "input_table",
            type = vector(element_type = ":country-stats-row"),
            location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats.csv"),
            representation = csv(schema = ":country-stats-row"),
            source = ":country-stats",
        ),
    ],
    outputs = [
        value(
            name = "report",
            type = ":country-stats-check-report",
            location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats_check.json"),
            representation = json(),
        ),
    ],
    execution = localhost(),
    action = action(
        name = "check_country_stats_action",
        inputs = [
            value(
                name = "input_table",
                location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats.csv"),
            ),
        ],
        outputs = [
            value(
                name = "report",
                location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats_check.json"),
            ),
        ],
        build = bazel(target = ":check_country_stats_task"),
    ),
)

task(
    name = "change_model",
    inputs = [
        value(
            name = "input_table",
            type = vector(element_type = ":country-stats-row"),
            location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats.csv"),
            representation = csv(schema = ":country-stats-row"),
            source = ":country-stats",
        ),
    ],
    outputs = [
        value(
            name = "model",
            type = ":population-change-model",
            location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/change_model.json"),
            representation = json(),
        ),
    ],
    execution = localhost(),
    action = action(
        name = "change_model_action",
        inputs = [
            value(
                name = "input_table",
                location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats.csv"),
            ),
        ],
        outputs = [
            value(
                name = "model",
                location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/change_model.json"),
            ),
        ],
        build = bazel(target = ":change_model_task"),
    ),
)

task(
    name = "continent_stats",
    inputs = [
        value(
            name = "input_table",
            type = vector(element_type = ":country-stats-row"),
            location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats.csv"),
            representation = csv(schema = ":country-stats-row"),
            source = ":country-stats",
        ),
        value(
            name = "model",
            type = ":population-change-model",
            location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/change_model.json"),
            representation = json(),
            source = ":change_model.model",
        ),
    ],
    outputs = [
        value(
            name = "table",
            type = vector(element_type = ":continent-stats-row"),
            location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/continent_stats.csv"),
            representation = csv(schema = ":continent-stats-row"),
        ),
    ],
    execution = localhost(),
    action = action(
        name = "continent_stats_action",
        inputs = [
            value(
                name = "input_table",
                location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/country_stats.csv"),
            ),
            value(
                name = "model",
                location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/change_model.json"),
            ),
        ],
        outputs = [
            value(
                name = "table",
                location = posix(path = "~/.cache/mlody/artifacts/hooli/basics/continent_stats.csv"),
            ),
        ],
        build = bazel(target = ":continent_stats_task"),
    ),
)
