load("//build/bzl:python.bzl", "o_py_library", "o_py_test")

o_py_library(
    name = "evaluator_lib",
    srcs = [
        "__init__.py",
        "evaluator.py",
        "registry.py",
        "testing.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//common/python/starlarkish/core:core_lib",
        "@pip//astropy",
        "@pip//uuid_utils",
    ],
)

o_py_library(
    name = "testing",
    testonly = True,
    srcs = ["testing.py"],
    visibility = ["//:__subpackages__"],
)

o_py_test(
    name = "evaluator_test",
    srcs = ["evaluator_test.py"],
    deps = [
        ":evaluator_lib",
        "//common/python/starlarkish/core:core_lib",
        "@pip//pyfakefs",
        "@pip//pytest",
    ],
)

o_py_test(
    name = "evaluator_generics_test",
    srcs = ["evaluator_generics_test.py"],
    deps = [
        ":evaluator_lib",
        "@pip//pytest",
    ],
)
